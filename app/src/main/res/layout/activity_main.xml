<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">

            <com.example.noteslist.NoteView
                android:id="@+id/note_1"
                style="@style/NoteViewStyle.NotRead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:elevation="8dp"
                app:date="08.03.2026"
                app:description="Завтра нужно появиться в универе (очень) аааа фывафывафыва шовщшаопывп"
                app:importance="false"
                app:layout_constraintTop_toTopOf="parent"
                app:title="Самое свежее" />

            <com.example.noteslist.NoteStackView
                android:id="@+id/note_stack_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:stackMaxVisible="2"
                app:stackSpacing="20dp"
                app:stackMaxChildElevation="16dp">

                <com.example.noteslist.NoteView
                    android:id="@+id/note_2"
                    style="@style/NoteViewStyle.NotRead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:elevation="8dp"
                    app:date="10.02.2025"
                    app:description="Завтра нужно появиться в универе (очень) аааа фывафывафыва"
                    app:importance="false"
                    app:layout_constraintTop_toTopOf="parent"
                    app:title="Ваще не свежее" />

                <com.example.noteslist.NoteView
                    android:id="@+id/note_3"
                    style="@style/NoteViewStyle.NotRead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:elevation="8dp"
                    app:date="10.03.2025"
                    app:description="Завтра нужно появиться в универе (очень) аааа фывафывафыва"
                    app:importance="false"
                    app:layout_constraintTop_toTopOf="parent"
                    app:title="Средне" />

                <com.example.noteslist.NoteView
                    android:id="@+id/note_4"
                    style="@style/NoteViewStyle.NotRead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:elevation="8dp"
                    app:date="08.03.2026"
                    app:description="Завтра нужно появиться в универе (очень) аааа фывафывафыва"
                    app:importance="true"
                    app:layout_constraintTop_toTopOf="parent"
                    app:title="Самое свежее" />
            </com.example.noteslist.NoteStackView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>